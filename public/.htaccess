# NestArcadia canonical redirects, MIME types and SPA fallback
RewriteEngine On

# Preserve manifest and favicon MIME types.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# Redirect the legacy portfolio route only on the production domain.
RewriteCond %{HTTP_HOST} ^(www\.)?nestarcadia\.com$ [NC]
RewriteRule ^homes/?$ https://nestarcadia.com/our-projects/ [R=301,L]

# 301: superseded modular kitchen article → canonical version
RewriteCond %{HTTP_HOST} ^(www\.)?nestarcadia\.com$ [NC]
RewriteRule ^journal/modular-kitchen-noida/?$ https://nestarcadia.com/journal/modular-kitchen-design-noida/ [R=301,L]

# Redirect www to apex and add the trailing slash in the same hop where needed.
RewriteCond %{HTTP_HOST} ^www\.nestarcadia\.com$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.nestarcadia\.com$ [NC]
RewriteRule ^(.*)$ https://nestarcadia.com/$1 [R=301,L]

# Canonicalize extensionless routes on the apex domain; leave static files alone.
RewriteCond %{HTTP_HOST} ^nestarcadia\.com$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

# Revalidate HTML while preserving the BFCache-friendly policy from main.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed assets can be cached aggressively.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Send all other client-side routes to the React app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
