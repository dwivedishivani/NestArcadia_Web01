# ============================================================
# NestArcadia — Apache configuration
# Hostinger shared hosting, mod_rewrite + mod_headers confirmed
# ============================================================

# ----- Security headers -----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ----- MIME types -----
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/json .json
  AddType text/markdown .md .txt
  AddType application/manifest+json .webmanifest
</IfModule>

# ----- Compression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml application/xml text/plain
</IfModule>

# ----- Cache control -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache hashed JS/CSS bundles aggressively
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images — 1 year
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # HTML — always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Well-known files — short cache
  <FilesMatch "(robots\.txt|sitemap\.xml|llms\.txt|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # RFC 8288 Link header — point agents at the llms.txt publisher guide
  Header always set Link "<https://nestarcadia.com/llms.txt>; rel=\"describedby\"; type=\"text/plain\""

  # Content-Type for llms.txt served as markdown
  <FilesMatch "llms\.txt$">
    Header set Content-Type "text/markdown; charset=UTF-8"
  </FilesMatch>

  # Proper JSON content-type for well-known JSON files
  <FilesMatch "\.json$">
    Header set Content-Type "application/json; charset=UTF-8"
  </FilesMatch>
</IfModule>

# ----- Rewrite rules -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Production-only legacy route and duplicate-URL redirects.
  # These run before scheme/host normalization so each route resolves in one hop.
  RewriteCond %{HTTP_HOST} ^(www\\.)?nestarcadia\\.com$ [NC]
  RewriteRule ^homes/?$ https://nestarcadia.com/our-projects/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\\.)?nestarcadia\\.com$ [NC]
  RewriteRule ^interior-design-noida-extension$ https://nestarcadia.com/interior-design-noida-extension/ [R=301,L]

  # Canonicalize www + extensionless paths in one hop.
  RewriteCond %{HTTP_HOST} ^www\\.nestarcadia\\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\\.[^/]+$
  RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

  # Canonicalize remaining www requests (including static assets).
  RewriteCond %{HTTP_HOST} ^www\\.nestarcadia\\.com$ [NC]
  RewriteRule ^(.*)$ https://nestarcadia.com/$1 [R=301,L]

  # Canonicalize extensionless apex routes. Preview domains are intentionally excluded.
  RewriteCond %{HTTP_HOST} ^nestarcadia\\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\\.(html|js|css|webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|json|txt|xml|webmanifest|map)$
  RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

  # Force HTTPS for the apex production domain, preserving already-canonical paths.
  RewriteCond %{HTTP_HOST} ^nestarcadia\\.com$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://nestarcadia.com%{REQUEST_URI} [R=301,L]

  # Serve static files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback — serve index.html for app routes on production and preview hosts.
  RewriteRule ^ /index.html [L]
</IfModule>

# ----- Real 404 for truly missing paths -----
# The SPA fallback above returns HTTP 200 for client-side routes.
# For genuinely missing static files, Apache's default 404 still fires
# because the RewriteCond %{REQUEST_FILENAME} -f check exits early
# only when the file exists. When neither a file nor directory exists,
# and the path matches no SPA route pattern, the SPA loads and React
# renders its own 404 component with a canonical noindex tag.
# For crawlers that land on unknown static paths, ErrorDocument below
# returns the SPA shell with a 404 status code at the HTTP layer.
ErrorDocument 404 /index.html
