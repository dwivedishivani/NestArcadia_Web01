# NestArcadia SPA redirects
RewriteEngine On

# Serve the Web App Manifest with its registered media type.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Preserve the legacy portfolio URL on the production domain.
# This is deliberately scoped to the real domain so Hostinger PR previews keep working.
RewriteCond %{HTTP_HOST} ^(www\.)?nestarcadia\.com$ [NC]
RewriteRule ^homes/?$ https://nestarcadia.com/our-projects/ [R=301,L]

# Redirect www to the apex host. Add the canonical trailing slash in the same hop
# for extensionless routes to avoid redirect chains.
RewriteCond %{HTTP_HOST} ^www\.nestarcadia\.com$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.nestarcadia\.com$ [NC]
RewriteRule ^(.*)$ https://nestarcadia.com/$1 [R=301,L]

# Canonicalize extensionless routes on the production apex host only.
# Preview domains and static files are not redirected to production.
RewriteCond %{HTTP_HOST} ^nestarcadia\.com$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+)$ https://nestarcadia.com/$1/ [R=301,L]

# HTML must always check for the latest deployment so browsers do not keep
# an old Vite entry file that points at deleted hashed JavaScript chunks.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    # Revalidate the public SPA shell on normal requests while keeping browser
    # back/forward page restores eligible for the BFCache.
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite's hashed assets are safe to cache aggressively because their filenames
  # change whenever their contents change.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Send all other client-side routes to the React app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
